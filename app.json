{
  "expo": {
    "name": "POKIT",
    "slug": "pokit",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/pokit3.png",
    "scheme": "pokit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yonghee.pokit",
      "buildNumber": "21"
    },
    "android": {
      "version": "1.4.1",
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#F2EDE4",
        "foregroundImage": "./assets/pokit3.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yonghee.pokit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/pokit3.png"
    },
    "plugins": [
      "expo-router",
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf511aec-1358-4869-ac51-99875807f10a"
      }
    },
    "owner": "yonghee"
  }
}
