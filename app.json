{
  "expo": {
    "name": "YOUR DAY",
    "slug": "pokit",
    "version": "1.9.18",
    "orientation": "portrait",
    "icon": "./assets/app-icon2-square.png",
    "scheme": "pokit",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/app-icon2-square.png",
      "color": "#000000"
    },
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "ko": "./locales/ko.json",
      "ja": "./locales/ja.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yonghee.pokit",
      "buildNumber": "109",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "ko",
          "ja"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "version": "1.9.18",
      "versionCode": 109,
      "adaptiveIcon": {
        "backgroundColor": "#CED2EC",
        "foregroundImage": "./assets/app-icon2-square.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yonghee.pokit",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon2-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "노트에 첨부할 사진을 앨범에서 선택하려면 사진 접근 권한이 필요해요."
        }
      ],
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#FEFEFF",
          "android": {
            "drawable": {
              "icon": "./assets/splash-background.xml"
            }
          },
          "dark": {
            "backgroundColor": "#FEFEFF"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon2-square.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4",
            "forceStaticLinking": []
          }
        }
      ],
      "@react-native-firebase/crashlytics",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "appUpdateManifestUrl": "https://raw.githubusercontent.com/yonghk423/pokit/main/remote-config/latest-app-version.json",
      "eas": {
        "projectId": "cf511aec-1358-4869-ac51-99875807f10a"
      }
    },
    "owner": "yonghee"
  }
}
