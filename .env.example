EXPO_PUBLIC_ALADIN_TTB_KEY=
EXPO_PUBLIC_OPEN_LIBRARY_CONTACT_EMAIL=
# OpenWeather key used by the in-app current weather summary (EAS production environment)
EXPO_PUBLIC_OPENWEATHER_API_KEY=
# RevenueCat public SDK keys (optional; falls back to dashboard test key in code)
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Supabase (publishable / anon only — never put service_role here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local development only: keep in ignored .env.local, never set in EAS production.
# Must match the narrowly scoped YOURDAY_AI_DEV_TOKEN Edge Function secret.
# Explicit opt-in; false uses normal user quota even in the simulator.
EXPO_PUBLIC_YOURDAY_AI_UNLIMITED=false
# The app sends it only when unlimited is true in a __DEV__ bundle.
EXPO_PUBLIC_YOURDAY_AI_DEV_TOKEN=

# Slack Incoming Webhook — 크래시/에러 발생 시마다 POST (Firebase Alerts와 별개)
EXPO_PUBLIC_SLACK_CRASH_WEBHOOK_URL=

OPENAI_API_KEY=

# Enable subscriptions in release builds only after store setup and purchase validation.
EXPO_PUBLIC_REVENUECAT_ENABLED=false
# Optional Test Store public SDK key; takes priority only in development builds.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Google Drive backup: public OAuth client IDs, same Google Cloud project on both platforms.
# Enable Drive API and configure OAuth consent screen / test users first.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
