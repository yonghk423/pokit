{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "scheme": "Pokit"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "scheme": "Pokit"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ENABLED": "true",
        "EXPO_PUBLIC_DOWNLOAD_ENVIRONMENT": "Production"
      },
      "autoIncrement": true,
      "ios": {
        "scheme": "Pokit"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ENABLED": "true",
        "EXPO_PUBLIC_DOWNLOAD_ENVIRONMENT": "Sandbox"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762331629"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
